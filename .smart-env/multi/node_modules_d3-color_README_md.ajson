olor.js \"Source\"","line":55},{"title":"CSS Color Module Level 3 specification","target":"https://www.w3.org/TR/css-color-3/#hsl-color","line":57},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/color.js \"Source\"","line":59},{"title":"CSS Object Model specification","target":"https://drafts.csswg.org/cssom/#serialize-a-css-component-value","line":61},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/color.js \"Source\"","line":63},{"title":"*color*.formatRgb","target":"#color_formatRgb","line":65},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/color.js \"Source\"","line":67},{"title":"RGB color picker","target":"http://bl.ocks.org/mbostock/78d64ca7ef013b4dcf8f","line":71},{"title":"RGB","target":"https://en.wikipedia.org/wiki/RGB_color_model","line":71},{"title":"color","target":"#color","line":73},{"title":"*color*","target":"#color","line":73},{"title":"*color*.rgb","target":"#color_rgb","line":73},{"title":"*color*.rgb","target":"#color_rgb","line":73},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/color.js \"Source\"","line":75},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/color.js \"Source\"","line":79},{"title":"HSL color picker","target":"http://bl.ocks.org/mbostock/debaad4fcce9bcee14cf","line":83},{"title":"HSL","target":"https://en.wikipedia.org/wiki/HSL_and_HSV","line":83},{"title":"color","target":"#color","line":85},{"title":"*color*","target":"#color","line":85},{"title":"*color*.rgb","target":"#color_rgb","line":85},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/color.js \"Source\"","line":87},{"title":"<>","target":"https://github.com/d3/d3-color/blob/master/src/lab.js \"Source\"","line":91},{"title":"CIELAB color picker","target":"http://bl.ocks.org/mbostock/9f37cc207c0cb166921b","line":95},{"title":"CIELAB","target":"https://en.wikipedia.org/wiki/Lab_color_space#CIELAB","line":95},{"title":"color","target":